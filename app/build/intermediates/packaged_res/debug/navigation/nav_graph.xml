<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/recordListFragment">

    <fragment
        android:id="@+id/recordListFragment"
        android:name="com.example.healthtracker.ui.RecordListFragment"
        android:label="Kayıtlar"
        tools:layout="@layout/fragment_record_list">
        <action
            android:id="@+id/action_to_addUserFragment"
            app:destination="@id/addUserFragment" />
        <action
            android:id="@+id/action_to_addRecordFragment"
            app:destination="@id/addRecordFragment" />
    </fragment>

    <fragment
        android:id="@+id/addUserFragment"
        android:name="com.example.healthtracker.ui.AddUserFragment"
        android:label="Kullanıcı Ekle"
        tools:layout="@layout/fragment_add_user" />

    <fragment
        android:id="@+id/addRecordFragment"
        android:name="com.example.healthtracker.ui.AddRecordFragment"
        android:label="Kayıt Ekle"
        tools:layout="@layout/fragment_add_record">
        <argument
            android:name="userId"
            app:argType="long" />
    </fragment>

</navigation>
