<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.healthtracker.ui.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_meals"
        android:name="com.example.healthtracker.ui.meals.MealsFragment"
        android:label="@string/nav_meals"
        tools:layout="@layout/fragment_meals" />

    <fragment
        android:id="@+id/navigation_habits"
        android:name="com.example.healthtracker.ui.habits.HabitsFragment"
        android:label="@string/nav_habits"
        tools:layout="@layout/fragment_habits" />

    <fragment
        android:id="@+id/navigation_coach"
        android:name="com.example.healthtracker.ui.coach.CoachFragment"
        android:label="@string/nav_coach"
        tools:layout="@layout/fragment_coach" />

    <fragment
        android:id="@+id/navigation_reports"
        android:name="com.example.healthtracker.ui.reports.ReportsFragment"
        android:label="@string/nav_reports"
        tools:layout="@layout/fragment_reports" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.healthtracker.ui.settings.ProfileSettingsFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile_settings" />

</navigation>
