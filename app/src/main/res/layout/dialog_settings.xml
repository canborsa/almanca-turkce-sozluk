<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nickname Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nickname"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/wood_dark"/>

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_nickname"
            android:inputType="textPersonName"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Language Selector Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_language"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/wood_dark"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinner_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <!-- Tabs / Buttons for Manual and Legal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_show_manual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/game_manual"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_show_legal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/legal_privacy"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Content Area for Manual / Legal text -->
        <TextView
            android:id="@+id/tv_settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manual_text"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:lineSpacingExtra="3dp"/>

    </LinearLayout>
</ScrollView>
