<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/farm_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Status Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <!-- Nickname / Level -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Farmer"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/wood_dark"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/seviye"/>

                        <TextView
                            android:id="@+id/tv_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lvl 1"
                            android:textSize="14sp"
                            android:textColor="@color/wood_dark"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Coins -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/altin"/>

                    <TextView
                        android:id="@+id/tv_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/wood_dark"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <!-- Energy -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/enerji"/>

                    <TextView
                        android:id="@+id/tv_energy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/wood_dark"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <!-- Settings Gear Icon -->
                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/cark"
                    android:scaleType="fitCenter"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Inventory Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/wood_light"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center">

                <!-- Wheat Inventory -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/bugday"/>

                <TextView
                    android:id="@+id/tv_wheat_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wheat: 5"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="20dp"/>

                <!-- Milk Inventory -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/sut"/>

                <TextView
                    android:id="@+id/tv_milk_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Milk: 2"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Farm Fields Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌾 Farm Plots"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="6dp"/>

        <!-- 2x2 Farm Plots Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:layout_marginBottom="16dp">

            <!-- Plot 0 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_plot_0"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/iv_plot_0"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/tarla"/>

                    <TextView
                        android:id="@+id/tv_plot_0_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plot_empty"
                        android:textSize="12sp"
                        android:textColor="@color/wood_dark"/>

                    <Button
                        android:id="@+id/btn_plot_0"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="10sp"
                        android:text="@string/plant_wheat"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Plot 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_plot_1"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/iv_plot_1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/tarla"/>

                    <TextView
                        android:id="@+id/tv_plot_1_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plot_empty"
                        android:textSize="12sp"
                        android:textColor="@color/wood_dark"/>

                    <Button
                        android:id="@+id/btn_plot_1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="10sp"
                        android:text="@string/plant_wheat"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Plot 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_plot_2"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/iv_plot_2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/tarla"/>

                    <TextView
                        android:id="@+id/tv_plot_2_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plot_empty"
                        android:textSize="12sp"
                        android:textColor="@color/wood_dark"/>

                    <Button
                        android:id="@+id/btn_plot_2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="10sp"
                        android:text="@string/plant_wheat"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Plot 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_plot_3"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/iv_plot_3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/tarla"/>

                    <TextView
                        android:id="@+id/tv_plot_3_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plot_empty"
                        android:textSize="12sp"
                        android:textColor="@color/wood_dark"/>

                    <Button
                        android:id="@+id/btn_plot_3"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="10sp"
                        android:text="@string/plant_wheat"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- Animals & Buildings Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐄 Animal Barns"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/inek"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cow_barn"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/wood_dark"/>

                    <TextView
                        android:id="@+id/tv_cow_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cow_hungry"
                        android:textSize="12sp"
                        android:textColor="@color/wood_light"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_cow_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feed_cow"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Order Delivery Kamyon/Araba Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚚 Delivery Truck"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/araba"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delivery_truck"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/wood_dark"/>

                    <TextView
                        android:id="@+id/tv_truck_requirements"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requires: 2 Wheat, 1 Milk"
                        android:textSize="12sp"
                        android:textColor="@color/wood_light"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_truck_deliver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deliver_order"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
